# Copie este archivo a `.env` y rellene los valores. `.env` está en .gitignore:
# nunca lo commitee, ni lo copie a /tmp, ni lo vuelque en un log.
#
#   cp .env.example .env
#
# Solo la credencial del modelo es obligatoria para correr en local. Todo lo
# demás tiene un valor por defecto razonable.


# ─────────────────────────────────────────────────────────────────────────────
# 1. Credencial del modelo — OBLIGATORIA. Elija UNA de las dos.
# ─────────────────────────────────────────────────────────────────────────────

# (a) Suscripción Claude (recomendada): se emite con `claude setup-token`.
#     Factura contra la suscripción, no contra créditos por token.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-EJEMPLO-reemplace-esto

# (b) API key de pago por token. Requiere saldo en la cuenta.
#     Si el token de arriba está presente, esta se ignora: la API de Anthropic
#     rechaza las peticiones que llevan las dos credenciales a la vez.
# ANTHROPIC_API_KEY=sk-ant-api03-EJEMPLO-reemplace-esto

# Otros proveedores, si cambia `RCM_PROVIDER`:
# OPENAI_API_KEY=sk-proj-EJEMPLO-reemplace-esto
# GOOGLE_API_KEY=AIzaEJEMPLO-reemplace-esto


# ─────────────────────────────────────────────────────────────────────────────
# 2. Llave de acceso — OBLIGATORIA si el servicio es alcanzable desde fuera
# ─────────────────────────────────────────────────────────────────────────────

# Protege TODAS las rutas de la API y las descargas de entregables. Sin ella el
# servicio queda abierto: no la deje vacía si escucha en 0.0.0.0.
# Genere una al azar, por ejemplo:  openssl rand -base64 24
#
# Es la que pide os.agno.com como «security key» al conectar el OS. Compártala
# solo con quien vaya a probar, y rótela cuando termine la prueba.
OS_SECURITY_KEY=EJEMPLO-genere-una-llave-al-azar-y-pongala-aqui


# ─────────────────────────────────────────────────────────────────────────────
# 3. Modelo y proveedor
# ─────────────────────────────────────────────────────────────────────────────

RCM_PROVIDER=anthropic          # anthropic | openai | google
RCM_MODEL_ID=claude-sonnet-4-5


# ─────────────────────────────────────────────────────────────────────────────
# 4. Almacenamiento
# ─────────────────────────────────────────────────────────────────────────────

# Sin DATABASE_URL se usa SQLite en RCM_DB_PATH, que es lo cómodo en local.
# En un despliegue con disco efímero (contenedores que duermen) hace falta
# Postgres, o las sesiones se pierden entre visitas.
# DATABASE_URL=postgresql://usuario:CONTRASENA@servidor.ejemplo.com/basedatos?sslmode=require

RCM_DB_PATH=data/rcm_runbook.db
RCM_EXPORTS_DIR=data/exports


# ─────────────────────────────────────────────────────────────────────────────
# 5. Servidor
# ─────────────────────────────────────────────────────────────────────────────

# 127.0.0.1 por defecto a propósito. Exponer en 0.0.0.0 sin OS_SECURITY_KEY
# deja el servicio abierto a quien encuentre el puerto.
RCM_HOST=127.0.0.1
RCM_PORT=7777


# ─────────────────────────────────────────────────────────────────────────────
# 6. Observabilidad
# ─────────────────────────────────────────────────────────────────────────────

RCM_LOG_LEVEL=INFO
RCM_OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.ejemplo.com
RCM_DEBUG_MODE=false


# ─────────────────────────────────────────────────────────────────────────────
# 7. Solo para el guion de verificación contra un despliegue
# ─────────────────────────────────────────────────────────────────────────────

# RCM_BASE_URL=https://su-despliegue.ejemplo.com
