# LLM auth — choose ONE of the two:
# (a) Claude subscription (recommended): mint with `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# (b) Pay-per-token API key (requires credits)
# ANTHROPIC_API_KEY=sk-ant-...

# Provider selection: anthropic | openai | google
RCM_PROVIDER=anthropic
RCM_MODEL_ID=claude-sonnet-4-5

# Storage
RCM_DB_PATH=data/rcm_runbook.db
RCM_EXPORTS_DIR=data/exports

# Observability
RCM_LOG_LEVEL=INFO
RCM_OTEL_ENABLED=false
RCM_DEBUG_MODE=false

# Server
RCM_HOST=0.0.0.0
RCM_PORT=7777
